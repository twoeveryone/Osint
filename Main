@bot.command()
async def check_domain(ctx, domain: str):
    domain_info = get_domain_info(domain)
    await ctx.send(f"Информация о домене: {domain_info}")

@bot.command()
async def check_username(ctx, username: str):
    social_media_results = analyze_social_media(username)
    response = "Результаты анализа соцсетей:\n"
    for platform, result in social_media_results.items():
        response += f"{platform}: {result}\n"
    await ctx.send(response)

@bot.command()
async def open_data(ctx, *, query: str):
    results = search_google(query)
    await ctx.send("Результаты поиска открытых данных:\n" + "\n".join(results))

